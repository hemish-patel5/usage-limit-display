
{
  "manifest_version": 3,
  "name": "ChatGPT Image Limit Tracker",
  "version": "1.0.0",
  "description": "Tracks ChatGPT image limits and sends them to a local Rust server.",
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:8766/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "ChatGPT Image Limits",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "chatgpt-image-tracker@local"
    }
  }
}
